    <bpmn:textAnnotation id="TextAnnotation_1xfqdqp">
      <bpmn:text>Total payment = Food cost + delivery cost + Pb1 tax + admin fee*</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_00jgsm2">
      <bpmn:text>Driver revenue = delivery cost * (1 - 20%)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_13fd43e">
      <bpmn:text>Restaurant  revenue = (Food cost + Pb1 tax) - (18.01% * 1.11 * food cost)(1 - 2%)</bpmn:text>
    </bpmn:textAnnotation>
